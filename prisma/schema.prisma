// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  LAB_HEAD
  PRODI_HEAD
  ADMIN_STAFF
  LAB_STAFF
}

model User {
  id       String @id @db.VarChar(7)
  email    String @unique @db.VarChar(255)
  name     String @db.VarChar(100)
  role     Role
  password String @db.VarChar(255)

  @@map("user")
}

enum Category {
  ELECTRONICS
  NON_ELECTRONICS
}

model Item {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  category    Category
  quantity    Int
  price       BigInt
  link        String       @db.VarChar(255)
  consumables Consumable[]

  @@map("item")
}

model Consumable {
  id     Int    @id @default(autoincrement())
  name   String
  unit   String
  stock  Int
  itemId Int    @unique @map("item_id")
  item   Item   @relation(fields: [itemId], references: [id])

  @@map("consumable")
}

enum DraftStatus {
  DRAFT
  LOCKED
}

model ProcurementDraft {
  id                Int                 @id @default(autoincrement())
  date              DateTime
  userId            Int                 @map("user_id")
  user              User                @relation(fields: [userId], references: [id])
  status            DraftStatus
  procurementDetail ProcurementDetail[]
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProcurementDetail {
  id               Int              @id @default(autoincrement())
  quntity          Int
  price            BigInt
  status           ReviewStatus
  draftId          Int              @map("draft_id")
  itemId           Int              @map("item_id")
  procurementDraft ProcurementDraft @relation(fields: [draftId], references: [id])
  item             Item             @relation(fields: [itemId], references: [id])
}
