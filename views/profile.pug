extends layouts/loggedin
include components/_form-components

block content
  .bg-white.p-8.rounded-xl.shadow-sm.border.border-gray-100
    h3.text-2xl.font-bold.text-gray-800.mb-2 Selamat Datang di SILAB
    p.text-gray-600.mb-8 Anda masuk sebagai #[span.font-semibold.text-blue-600= user.role]

    .grid.grid-cols-1(class="md:grid-cols-3").gap-6
      .bg-blue-50.p-6.rounded-lg.border.border-blue-100
        h4.text-sm.font-bold.text-blue-700.uppercase.tracking-wider.mb-4 Profil Akun
        .space-y-3
          div
            p.text-xs.text-blue-500.font-semibold Nama Lengkap
            p.text-gray-800= user.name
          div
            p.text-xs.text-blue-500.font-semibold Email
            p.text-gray-800= user.email
          div
            p.text-xs.text-blue-500.font-semibold Role / Jabatan
            span.inline-block.mt-1.px-2.py-1.bg-blue-600.text-white.text-xs.rounded= user.role

      .col-span-2.bg-white.p-6.rounded-lg.border.border-gray-200.shadow-sm.flex.flex-col
        h4.text-sm.font-bold.text-gray-700.uppercase.tracking-wider.mb-4 Ganti Password
        
        if success
          .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-4.flex.items-center.gap-3(role="alert")
            svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
            span= success
            
        if error
          .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-4.flex.items-center.gap-3(role="alert")
            svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
              path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
            span= error

        form(action="/change-password" method="POST").space-y-4
          +passwordInput('current_password', 'Password Saat Ini', true, 'Masukkan password saat ini', 255)
          +passwordInput('password', 'Password Baru', true, 'Minimal 8 karakter', 255)
          +passwordInput('password_confirmation', 'Konfirmasi Password Baru', true, 'Ulangi password baru', 255)
          .pt-2
            +primaryButton('Ganti Password')
