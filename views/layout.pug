doctype html
html(lang="id")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SILAB | #{title} 
    link(rel="stylesheet", href="/css/style.css")
  body.bg-gray-100.min-h-screen.flex.flex-col
    if user
      .flex.flex-1.min-h-screen
        // Sidebar
        aside.w-64.bg-blue-800.text-white.flex-shrink-0.hidden(class="md:flex flex-col")
          .p-6.border-b.border-blue-700
            h1.text-2xl.font-bold SILAB
            p.text-xs.text-blue-300 Sistem Inventaris Laboratorium
          
          nav.flex-1.p-4.space-y-2
            a.block.px-4.py-2.rounded.bg-blue-900.font-semibold(href="/dashboard") Dashboard
            //- Menu lainnya bisa ditambahkan di sini nanti
          
          .p-4.border-t.border-blue-700
            form(action="/logout" method="POST")
              button(type="submit").w-full.flex.items-center.gap-2.px-4.py-2.text-red-300.hover_bg-blue-900.rounded.transition
                span Keluar (Logout)

        // Main Content Area
        .flex-1.flex.flex-col
          header.bg-white.shadow-sm.p-4.flex.justify-between.items-center
            h2.text-xl.font-semibold.text-gray-800= title
            .text-sm.text-gray-600 Halo, #[span.font-bold= user.name]
          main.p-8
            block content
    else
      header.bg-blue-600.text-white.p-4.shadow-md
        h1.text-2xl.font-bold SILAB
        p.text-sm Sistem Informasi Inventaris Laboratorium
      main.container.mx-auto.mt-8.p-4.bg-white.rounded-lg.shadow
        block content
