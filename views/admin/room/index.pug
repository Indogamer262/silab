extends ../../layouts/loggedin
include ../../components/_form-components

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Daftar Ruangan
      p.text-sm.text-gray-500.mt-1 Kelola semua ruangan laboratorium
    a(href="/admin/rooms/create")
      +primaryButton('+ Tambah Ruangan', 'button')

  //- Table
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.overflow-hidden
    .overflow-x-auto
      table.w-full.text-sm
        thead
          tr.bg-gray-50.border-b.border-gray-200
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs ID
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Nama Ruangan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Kapasitas
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Lokasi
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Penanggung Jawab
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aksi
        tbody
          if rooms && rooms.length > 0
            each room in rooms
              tr.border-b.border-gray-100.hover_bg-gray-50.transition
                td.px-6.py-4.font-mono.text-gray-700= room.id
                td.px-6.py-4.font-medium.text-gray-900= room.name
                td.px-6.py-4.text-center.text-gray-600= room.capacity
                td.px-6.py-4.text-gray-600= room.location
                td.px-6.py-4
                  span.text-gray-800= room.user.name
                td.px-6.py-4.text-center
                  .flex.items-center.justify-center.gap-2
                    +warningButton('Edit', `/admin/rooms/${room.id}/edit`)
                    form.inline(action=`/admin/rooms/${room.id}/delete` method="POST")
                      +dangerButton('Hapus')
          else
            tr
              td.px-6.py-8.text-center.text-gray-400(colspan="6")
                p.text-lg.mb-1 Belum ada data ruangan
                p.text-sm Klik "Tambah Ruangan" untuk memulai
