extends ../../layouts/loggedin

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Kelola Label &amp; QR Inventaris
      p.text-sm.text-gray-500.mt-1 Berikan penomoran label, update lokasi penempatan, dan cetak QR Code/Barcode barang.

  //- Search & Filters
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.p-4.mb-6
    form(action="/admin-staff/inventory" method="GET" class="flex flex-wrap items-center gap-4")
      .flex.flex-col.gap-1.min-w-60
        label(for="search").text-xs.font-semibold.text-gray-500 Cari Barang / QR Code
        input(
          type="text"
          name="search"
          id="search"
          value=search
          placeholder="Nama barang atau label..."
          class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition"
        )

      .flex.flex-col.gap-1.min-w-40
        label(for="filter-room").text-xs.font-semibold.text-gray-500 Filter Ruangan
        select(name="roomId" id="filter-room" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition")
          option(value="") -- Semua Ruang --
          each rm in rooms
            option(value=rm.id selected=(selectedRoom === rm.id.toString()))= rm.name

      .flex.flex-col.gap-1.min-w-40
        label(for="filter-condition").text-xs.font-semibold.text-gray-500 Filter Kondisi
        select(name="condition" id="filter-condition" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition")
          option(value="") -- Semua Kondisi --
          option(value="GOOD" selected=(selectedCondition === 'GOOD')) Baik (GOOD)
          option(value="FAIR" selected=(selectedCondition === 'FAIR')) Cukup (FAIR)
          option(value="POOR" selected=(selectedCondition === 'POOR')) Buruk (POOR)
          option(value="BROKEN" selected=(selectedCondition === 'BROKEN')) Rusak (BROKEN)
          option(value="LOST" selected=(selectedCondition === 'LOST')) Hilang (LOST)

      .flex.items-end.gap-2.h-full.pt-5
        button(type="submit" class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-1.5 rounded-lg text-sm font-semibold transition shadow-sm") Filter
        a(href="/admin-staff/inventory" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-1.5 rounded-lg text-sm font-semibold transition border border-gray-200") Reset

  //- Selection Action Bar (floating at bottom)
  div(id="selection-bar" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 hidden")
    div(class="bg-gray-900 text-white pl-5 pr-3 py-3 rounded-2xl flex items-center gap-5 shadow-2xl border border-gray-700")
      .flex.items-center.gap-2
        div(class="bg-blue-500 text-white w-7 h-7 rounded-full flex items-center justify-center text-sm font-bold" id="selection-count") 0
        span.text-sm.font-medium barang dipilih
      .flex.items-center.gap-2
        button(type="button" onclick="clearSelection()" class="text-gray-400 hover:text-white px-3 py-1.5 rounded-lg text-sm font-medium transition hover:bg-gray-800") Batal
        button(type="button" onclick="printSelectedQR()" class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-1.5 rounded-lg text-sm font-semibold transition flex items-center gap-2 shadow-sm")
          svg.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z")
          | Cetak QR Label

  //- Table
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.overflow-hidden
    .overflow-x-auto
      table.w-full.text-sm
        thead
          tr.bg-gray-50.border-b.border-gray-200
            th.px-4.py-3.text-center(style="width:40px")
              input(
                type="checkbox"
                id="select-all"
                class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                onchange="toggleSelectAll(this)"
                title="Pilih semua di halaman ini"
              )
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs QR Code / Label
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs QR Visual
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Nama Barang
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Ruangan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Kondisi
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Tgl Diterima
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aksi
        tbody
          if inventories && inventories.length > 0
            each inv in inventories
              tr(class="border-b border-gray-100 hover:bg-gray-50 transition" data-inv-id=inv.id)
                td.px-4.py-4.text-center
                  input(
                    type="checkbox"
                    class="inv-checkbox w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                    data-id=inv.id
                    data-qr=inv.qrCode
                    data-name=inv.item.name
                    onchange="toggleSelection(this)"
                  )
                td.px-6.py-4.font-mono.text-gray-700.font-semibold= inv.qrCode
                td.px-6.py-4
                  img(
                    src=`https://api.qrserver.com/v1/create-qr-code/?size=48x48&data=${encodeURIComponent(inv.qrCode)}`
                    alt=inv.qrCode
                    class="w-12 h-12 border border-gray-200 rounded p-0.5 bg-white shadow-sm hover:scale-125 transition cursor-pointer"
                    onclick=`viewLargeQR('${inv.qrCode}', '${inv.item.name.replace(/'/g, "\\\\'")}')`
                    title="Perbesar QR Code"
                  )
                td.px-6.py-4
                  p.font-medium.text-gray-900= inv.item.name
                  span(class="text-xs text-gray-400")= inv.item.category
                td.px-6.py-4.text-gray-600= inv.room.name
                td.px-6.py-4.text-center
                  - let color = 'bg-gray-100 text-gray-800'
                  if inv.condition === 'GOOD'
                    - color = 'bg-green-100 text-green-800'
                  else if inv.condition === 'FAIR'
                    - color = 'bg-yellow-100 text-yellow-800'
                  else if inv.condition === 'POOR'
                    - color = 'bg-orange-100 text-orange-800'
                  else if inv.condition === 'BROKEN'
                    - color = 'bg-red-100 text-red-800'
                  else if inv.condition === 'LOST'
                    - color = 'bg-purple-100 text-purple-800'
                  span(class=`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold ${color}`)= inv.condition
                td.px-6.py-4.text-center.text-gray-500
                  = inv.receivedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'numeric', year: 'numeric' })
                td.px-6.py-4.text-center
                  .flex.items-center.justify-center.gap-2
                    a(
                      href=`/admin-staff/inventory/${inv.id}/edit`
                      class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white px-3 py-1.5 rounded-lg transition font-semibold text-xs shadow-sm"
                    ) Edit Label
  //- QR Detail Modal
  div(id="qr-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden")
    // backdrop
    div(class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity duration-200 opacity-0" id="qr-backdrop" onclick="closeQRModal()")
    // modal content
    div(class="bg-white rounded-xl shadow-xl max-w-sm w-full p-6 relative z-10 mx-4 transform transition-all scale-95 duration-200 opacity-0 text-center" id="qr-content")
      .flex.items-center.justify-between.mb-4.pb-3.border-b
        h3#qr-modal-title.text-lg.font-bold.text-gray-800 QR Code Label
        button(type="button" class="text-gray-400 hover:text-gray-600 transition" onclick="closeQRModal()")
          svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
      
      div.flex.flex-col.items-center.justify-center.p-4.bg-gray-50.rounded-lg.mb-4
        img(id="large-qr-img" src="" alt="Large QR Code" class="w-48 h-48 border border-gray-200 rounded p-1 bg-white mb-3 shadow-md")
        span#qr-modal-label.font-mono.text-lg.font-bold.text-gray-800
        p#qr-modal-desc.text-xs.text-gray-500.mt-1

      .flex.justify-center
        button(type="button" class="border border-gray-300 text-gray-700 px-5 py-2 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition font-semibold text-sm" onclick="closeQRModal()") Tutup

  script(type="module").
    import { getSelection, saveSelection, clearSelection, toggleSelection, toggleSelectAll } from '/js/selection.js';
    import { printSelectedQR } from '/js/print.js';

    // Make functions available globally for inline onclick attributes
    window.toggleSelection = (checkbox) => {
      toggleSelection(checkbox.dataset.id, checkbox.dataset.qr, checkbox.dataset.name, checkbox.checked);
      updateSelectionUI();
    };

    window.toggleSelectAll = (masterCheckbox) => {
      const allBoxes = document.querySelectorAll('.inv-checkbox');
      toggleSelectAll(masterCheckbox.checked, allBoxes);
      updateSelectionUI();
    };

    window.clearSelection = () => {
      clearSelection();
      updateSelectionUI();
    };

    window.printSelectedQR = () => {
      const sel = getSelection();
      printSelectedQR(Object.values(sel));
    };

    function updateSelectionUI() {
      const sel = getSelection();
      const count = Object.keys(sel).length;
      const bar = document.getElementById('selection-bar');
      const badge = document.getElementById('selection-count');

      if (count > 0) {
        bar.classList.remove('hidden');
        badge.textContent = count;
      } else {
        bar.classList.add('hidden');
      }

      // Sync checkboxes with stored selection
      document.querySelectorAll('.inv-checkbox').forEach(cb => {
        cb.checked = !!sel[cb.dataset.id];
      });

      // Update select-all state
      const allBoxes = document.querySelectorAll('.inv-checkbox');
      const selectAll = document.getElementById('select-all');
      if (allBoxes.length > 0) {
        const allChecked = Array.from(allBoxes).every(cb => cb.checked);
        const someChecked = Array.from(allBoxes).some(cb => cb.checked);
        selectAll.checked = allChecked;
        selectAll.indeterminate = someChecked && !allChecked;
      }
    }

    // Restore selection on page load
    document.addEventListener('DOMContentLoaded', updateSelectionUI);

    // ===== Single QR Modal =====
    let currentQRCode = '';
    let currentQRName = '';

    window.viewLargeQR = (code, name) => {
      const modal = document.getElementById('qr-modal');
      const backdrop = document.getElementById('qr-backdrop');
      const content = document.getElementById('qr-content');
      const img = document.getElementById('large-qr-img');
      const label = document.getElementById('qr-modal-label');
      const desc = document.getElementById('qr-modal-desc');
      
      currentQRCode = code;
      currentQRName = name;
      
      img.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(code)}`;
      label.textContent = code;
      desc.textContent = name;
      
      modal.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        content.classList.remove('opacity-0', 'scale-95');
        content.classList.add('opacity-100', 'scale-100');
      }, 10);
    };

    window.closeQRModal = () => {
      const modal = document.getElementById('qr-modal');
      const backdrop = document.getElementById('qr-backdrop');
      const content = document.getElementById('qr-content');
      
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      content.classList.remove('opacity-100', 'scale-100');
      content.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    };
