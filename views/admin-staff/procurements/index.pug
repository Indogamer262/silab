extends ../../layouts/loggedin

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Penerimaan Barang Pengadaan
      p.text-sm.text-gray-500.mt-1 Lihat draf usulan pengadaan barang yang telah diajukan dan kelola penerimaan fisiknya.

  //- Table
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.overflow-hidden
    .overflow-x-auto
      table.w-full.text-sm
        thead
          tr.bg-gray-50.border-b.border-gray-200
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs ID Draf
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Tanggal Pengajuan
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Diajukan Oleh
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Progress Penerimaan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Status Penerimaan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aksi
        tbody
          if drafts && drafts.length > 0
            each draft in drafts
              tr(class="border-b border-gray-100 hover:bg-gray-50 transition")
                td.px-6.py-4.font-mono.text-gray-700= `#PR-${draft.id.toString().padStart(4, '0')}`
                td.px-6.py-4.text-gray-600
                  = draft.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                td.px-6.py-4.text-gray-800.font-medium= draft.user.name
                td.px-6.py-4.text-center
                  if draft.hasAcceptedItems
                    div.flex.items-center.justify-center.gap-2
                      div(class="w-24 bg-gray-200 rounded-full h-2")
                        - const percent = Math.min(100, Math.round((draft.totalReceivedQty / draft.totalAcceptedQty) * 100))
                        div(class="bg-blue-600 h-2 rounded-full" style=`width: ${percent}%`)
                      span.text-xs.font-bold.text-gray-700= `${draft.totalReceivedQty} / ${draft.totalAcceptedQty}`
                  else
                    span.text-gray-400 -
                td.px-6.py-4.text-center
                  span(class=`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium ${draft.statusColor}`)
                    = draft.statusLabel
                td.px-6.py-4.text-center
                  if draft.hasAcceptedItems
                    a(href=`/admin-staff/procurements/${draft.id}` class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-2 rounded-lg transition font-semibold text-sm shadow-sm")
                      | Kelola Penerimaan
                  else
                    span.text-gray-400 (Tidak ada barang disetujui)
          else
            tr
              td.px-6.py-8.text-center.text-gray-400(colspan="6")
                p.text-lg.mb-1 Belum ada usulan pengadaan barang yang diajukan.
                p.text-sm Draf pengadaan harus dikunci oleh Kepala Lab dan disetujui Ketua Prodi terlebih dahulu.
