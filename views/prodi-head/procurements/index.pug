extends ../../layouts/loggedin
include ../../components/_form-components

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Review Pengadaan Barang
      p.text-sm.text-gray-500.mt-1 Review dan finalisasi draf pengadaan barang yang diajukan oleh Kepala Laboratorium.

  //- Filter Form
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.p-4.mb-6
    form(action="/prodi-head/procurements" method="GET" class="flex flex-wrap items-center gap-4")
      .flex.flex-col.gap-1.min-w-64
        label(for="search").text-xs.font-semibold.text-gray-500 Cari Draf
        input(type="text" name="search" id="search" value=search placeholder="ID Draf atau Nama Pengaju..." class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition")
      
      .flex.flex-col.gap-1.min-w-48
        label(for="status").text-xs.font-semibold.text-gray-500 Status
        select(name="status" id="status" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition")
          option(value="") -- Semua Status --
          option(value="LOCKED" selected=(selectedStatus === 'LOCKED')) Menunggu Review (Locked)
          option(value="FINALIZED" selected=(selectedStatus === 'FINALIZED')) Difinalisasi (Selesai)

      .flex.items-end.gap-2.h-full.pt-5
        button(type="submit" class="bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-1.5 rounded-lg text-sm font-semibold transition shadow-sm") Cari
        a(href="/prodi-head/procurements" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-1.5 rounded-lg text-sm font-semibold transition border border-gray-200") Reset

  //- Table
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.overflow-hidden
    .overflow-x-auto
      table.w-full.text-sm
        thead
          tr.bg-gray-50.border-b.border-gray-200
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs ID Draf
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Diajukan Oleh
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Tanggal Pengajuan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Total Biaya
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Status
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aksi
        tbody
          if drafts && drafts.length > 0
            each draft in drafts
              tr(class="border-b border-gray-100 hover:bg-gray-50 transition")
                td.px-6.py-4.font-mono.text-gray-700= `#PR-${draft.id.toString().padStart(4, '0')}`
                td.px-6.py-4.text-gray-800.font-medium= draft.user.name
                td.px-6.py-4.text-gray-600
                  = draft.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                td.px-6.py-4.text-center.text-gray-800
                  - let totalCost = 0n
                  each detail in draft.procurementDetails
                    - totalCost += detail.price
                  p.font-medium= formatRupiah(totalCost)
                  p.text-xs.text-gray-500 #{draft.procurementDetails.length} Item
                td.px-6.py-4.text-center
                  if draft.status === 'LOCKED'
                    span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800")
                      svg.w-3.h-3(fill="currentColor" viewBox="0 0 20 20")
                        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd")
                      | Menunggu Review
                  else if draft.status === 'FINALIZED'
                    span(class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800")
                      svg.w-3.h-3(fill="currentColor" viewBox="0 0 20 20")
                        path(fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd")
                      | Difinalisasi
                td.px-6.py-4.text-center
                  a(href=`/prodi-head/procurements/${draft.id}` class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-2 rounded-lg transition font-semibold text-sm shadow-sm")
                    if draft.status === 'LOCKED'
                      | Review
                    else
                      | Lihat Detail
          else
            tr
              td.px-6.py-8.text-center.text-gray-400(colspan="6")
                p.text-lg.mb-1 Belum ada draf pengadaan yang perlu direview.
