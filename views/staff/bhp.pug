extends ../layouts/loggedin
include ../components/_form-components

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Pengelolaan Stok Barang Habis Pakai (BHP)
      p.text-sm.text-gray-500.mt-1 Perbarui jumlah stok secara manual untuk menyeimbangkan inventaris fisik lab.

  //- Table BHP
  .bg-white.rounded-xl.shadow-sm.border.border-gray-100.overflow-hidden
    .overflow-x-auto
      table.w-full.text-sm
        thead
          tr.bg-gray-50.border-b.border-gray-200
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs No
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Nama BHP
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Kategori
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Stok Saat Ini
            th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Satuan
            th.px-6.py-3.text-center.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aksi
        tbody
          if consumables && consumables.length > 0
            each cons, idx in consumables
              tr.border-b.border-gray-100.hover_bg-gray-50.transition
                td.px-6.py-4.text-gray-500= idx + 1
                td.px-6.py-4.font-medium.text-gray-900= cons.name
                td.px-6.py-4
                  span(class="inline-block px-2 py-0.5 text-xs rounded-full " + (cons.item.category === 'ELECTRONICS' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' : 'bg-orange-50 text-orange-700 border border-orange-200'))
                    = cons.item.category === 'ELECTRONICS' ? 'Elektronik' : 'Non-Elektronik'
                td.px-6.py-4.text-center.font-semibold(class=(cons.stock === 0 ? 'text-red-600' : 'text-gray-800'))= cons.stock
                td.px-6.py-4.text-gray-600= cons.unit
                td.px-6.py-4.text-center
                  button(
                    type="button"
                    onclick=`openStockModal(${cons.id}, "${cons.name}", ${cons.stock}, "${cons.unit}")`
                    class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow-sm transition"
                  ) Update Stok
          else
            tr
              td.px-6.py-8.text-center.text-gray-400(colspan="6") Belum ada data BHP terdaftar.

  //- Modal Update Stok
  #stock-modal(class="fixed inset-0 z-50 flex items-center justify-center hidden")
    #stock-backdrop(class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity duration-200 opacity-0" onclick="closeStockModal()")
    #stock-content(class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative z-10 mx-4 transform transition-all scale-95 duration-200 opacity-0")
      .flex.items-center.justify-between.mb-4.pb-3.border-b
        h3.text-lg.font-bold.text-gray-800 Update Stok BHP
        button(type="button" class="text-gray-400 hover:text-gray-600 transition" onclick="closeStockModal()")
          svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
      
      form(action="/staff/bhp/update-stock" method="POST" class="space-y-4")
        input(type="hidden" name="id" id="modal-id")
        
        div
          p.text-xs.text-gray-400 Nama Barang
          p#modal-name.font-semibold.text-gray-800.text-sm -
        
        div
          p.text-xs.text-gray-400 Stok Saat Ini
          p#modal-stock.font-bold.text-gray-800.text-sm -
        
        .flex.flex-col.gap-1
          label(for="action").font-medium.text-gray-700.text-sm Tindakan
          select(
            name="action"
            id="action"
            required
            class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white text-sm"
          )
            option(value="add") Tambah Stok (+)
            option(value="subtract") Kurang Stok (-)

        .flex.flex-col.gap-1
          label(for="quantity").font-medium.text-gray-700.text-sm Jumlah
          .flex.items-center.gap-2
            input(
              type="number"
              name="quantity"
              id="quantity"
              required
              min="1"
              placeholder="Masukkan jumlah..."
              class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
            )
            span#modal-unit.text-gray-500.text-sm -

        .pt-4.border-t.border-gray-100.flex.justify-end.gap-2
          button(type="button" class="border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition font-semibold text-sm" onclick="closeStockModal()") Batal
          button(type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition font-semibold text-sm shadow-sm") Simpan Perubahan

  script.
    function openStockModal(id, name, stock, unit) {
      document.getElementById('modal-id').value = id;
      document.getElementById('modal-name').textContent = name;
      document.getElementById('modal-stock').textContent = stock + ' ' + unit;
      document.getElementById('modal-unit').textContent = unit;
      
      const modal = document.getElementById('stock-modal');
      const backdrop = document.getElementById('stock-backdrop');
      const content = document.getElementById('stock-content');
      
      modal.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        content.classList.remove('opacity-0', 'scale-95');
        content.classList.add('opacity-100', 'scale-100');
      }, 10);
    }

    function closeStockModal() {
      const modal = document.getElementById('stock-modal');
      const backdrop = document.getElementById('stock-backdrop');
      const content = document.getElementById('stock-content');
      
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      content.classList.remove('opacity-100', 'scale-100');
      content.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }
