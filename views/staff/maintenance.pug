extends ../layouts/loggedin
include ../components/_form-components

block content
  //- Flash Messages
  if success
    .bg-green-50.border.border-green-300.text-green-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd")
      span= success

  if error
    .bg-red-50.border.border-red-300.text-red-800.px-4.py-3.rounded-lg.mb-6.flex.items-center.gap-3(role="alert")
      svg.w-5.h-5.flex-shrink-0(fill="currentColor" viewBox="0 0 20 20")
        path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
      span= error

  //- Header
  .flex.items-center.justify-between.mb-6
    div
      h3.text-2xl.font-bold.text-gray-800 Log Maintenance &amp; Kondisi Aset
      p.text-sm.text-gray-500.mt-1 Catat aktivitas perawatan rutin, perbaikan inventaris, dan kelola pemakaian BHP.
    button(
      type="button"
      onclick="openMaintenanceModal()"
      class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition font-semibold text-sm shadow-sm"
    )
      | + Catat Maintenance

  //- Grid Layout
  .grid.grid-cols-1(class="lg:grid-cols-3").gap-6
    //- Left Card: Inventaris & Kondisi Saat Ini
    div(class="lg:col-span-1 bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col")
      h4.text-lg.font-bold.text-gray-800.mb-4 Daftar Kondisi Aset Lab
      .space-y-4.flex-1.overflow-y-auto.max-h-120
        if inventories && inventories.length > 0
          each inv in inventories
            .p-3.border.border-gray-100.rounded-lg.hover_bg-gray-50.transition.flex.items-center.justify-between
              div
                p.font-semibold.text-gray-900.text-sm= inv.item.name
                p.font-mono.text-xs.text-gray-400= inv.qrCode || 'No QR'
                p(class="text-xs text-gray-500 mt-0.5")= inv.room.name
              div
                if inv.condition === 'GOOD'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800") GOOD
                else if inv.condition === 'FAIR'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800") FAIR
                else if inv.condition === 'POOR'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800") POOR
                else if inv.condition === 'BROKEN'
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800") BROKEN
                else
                  span(class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800") LOST
        else
          p.text-sm.text-gray-400 Belum ada aset terdaftar.

    //- Right Table: Riwayat Log Maintenance
    div(class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col")
      .p-5.border-b.border-gray-100.bg-gray-50
        h4.text-base.font-bold.text-gray-800 Riwayat Aktivitas Perawatan (Maintenance Logs)
      .overflow-x-auto.flex-1
        table.w-full.text-sm
          thead
            tr.bg-gray-50.border-b.border-gray-200
              th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Tanggal
              th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Aset / Item
              th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Deskripsi Aktivitas
              th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Penggunaan BHP
              th.px-6.py-3.text-left.font-semibold.text-gray-600.uppercase.tracking-wider.text-xs Oleh
          tbody
            if logs && logs.length > 0
              each log in logs
                tr.border-b.border-gray-100.hover_bg-gray-50.transition
                  td.px-6.py-4.text-gray-500.whitespace-nowrap
                    = log.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })
                  td.px-6.py-4
                    p.font-semibold.text-gray-900= log.inventory.item.name
                    p.font-mono.text-xs.text-gray-400= log.inventory.qrCode || '-'
                  td.px-6.py-4.text-gray-700= log.description
                  td.px-6.py-4
                    if log.consumable
                      span(class="inline-block px-2 py-0.5 bg-purple-100 text-purple-800 text-xs rounded-full font-medium")
                        | #{log.consumable.name} (-#{log.consumableUsedQty} #{log.consumable.unit})
                    else
                      span.text-gray-400 -
                  td.px-6.py-4.text-gray-600= log.user.name
            else
              tr
                td.px-6.py-8.text-center.text-gray-400(colspan="5") Belum ada log maintenance tercatat.

  //- Modal Catat Maintenance
  #maintenance-modal(class="fixed inset-0 z-50 flex items-center justify-center hidden")
    #maintenance-backdrop(class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity duration-200 opacity-0" onclick="closeMaintenanceModal()")
    #maintenance-content(class="bg-white rounded-xl shadow-xl max-w-xl w-full p-6 relative z-10 mx-4 transform transition-all scale-95 duration-200 opacity-0")
      .flex.items-center.justify-between.mb-4.pb-3.border-b
        h3.text-lg.font-bold.text-gray-800 Catat Aktivitas Perawatan / Perbaikan
        button(type="button" class="text-gray-400 hover:text-gray-600 transition" onclick="closeMaintenanceModal()")
          svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
      
      form(action="/staff/maintenance/log" method="POST" class="space-y-4")
        //- Select Asset
        .flex.flex-col.gap-1
          label(for="inventoryId").font-medium.text-gray-700.text-sm Barang Inventaris / Aset
          select(
            name="inventoryId"
            id="inventoryId"
            required
            class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white text-sm"
          )
            option(value="" disabled selected) -- Pilih Aset --
            each inv in inventories
              option(value=inv.id) [#{inv.qrCode || 'No QR'}] #{inv.item.name} - #{inv.room.name} (#{inv.condition})

        //- Select New Condition
        .flex.flex-col.gap-1
          label(for="condition").font-medium.text-gray-700.text-sm Update Kondisi Aset
          select(
            name="condition"
            id="condition"
            required
            class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white text-sm"
          )
            option(value="GOOD") Baik (GOOD)
            option(value="FAIR") Cukup Baik (FAIR)
            option(value="POOR") Buruk (POOR)
            option(value="BROKEN") Rusak (BROKEN)
            option(value="LOST") Hilang (LOST)

        //- Description of Maintenance
        .flex.flex-col.gap-1
          label(for="description").font-medium.text-gray-700.text-sm Deskripsi Aktivitas Perawatan
          textarea(
            name="description"
            id="description"
            rows="3"
            required
            placeholder="Contoh: Pembersihan rutin, pengelasan ulang kaki meja, kalibrasi ulang tegangan..."
            class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
          )

        //- Consumables Section (Optional)
        .border-t.border-dashed.border-gray-100.pt-4.space-y-4
          h5.text-sm.font-bold.text-gray-700 Penggunaan Bahan Habis Pakai (BHP) - Opsional
          .grid.grid-cols-1(class="md:grid-cols-2").gap-4
            .flex.flex-col.gap-1
              label(for="consumableId").font-medium.text-gray-700.text-sm Nama BHP
              select(
                name="consumableId"
                id="consumableId"
                class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-white text-sm"
              )
                option(value="") -- Tidak Menggunakan BHP --
                each cons in consumables
                  option(value=cons.id) #{cons.name} (Sisa Stok: #{cons.stock} #{cons.unit})
            
            .flex.flex-col.gap-1
              label(for="consumableQty").font-medium.text-gray-700.text-sm Jumlah yang Digunakan
              input(
                type="number"
                name="consumableQty"
                id="consumableQty"
                min="1"
                placeholder="Jumlah..."
                class="border border-gray-300 rounded-lg px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
              )

        .pt-4.border-t.border-gray-100.flex.justify-end.gap-2
          button(type="button" class="border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition font-semibold text-sm" onclick="closeMaintenanceModal()") Batal
          button(type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 active:bg-blue-800 transition font-semibold text-sm shadow-sm") Simpan Aktivitas

  script.
    function openMaintenanceModal() {
      const modal = document.getElementById('maintenance-modal');
      const backdrop = document.getElementById('maintenance-backdrop');
      const content = document.getElementById('maintenance-content');
      
      modal.classList.remove('hidden');
      setTimeout(() => {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        content.classList.remove('opacity-0', 'scale-95');
        content.classList.add('opacity-100', 'scale-100');
      }, 10);
    }

    function closeMaintenanceModal() {
      const modal = document.getElementById('maintenance-modal');
      const backdrop = document.getElementById('maintenance-backdrop');
      const content = document.getElementById('maintenance-content');
      
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      content.classList.remove('opacity-100', 'scale-100');
      content.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }
