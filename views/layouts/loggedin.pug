
doctype html
html(lang="id")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title SILAB | #{title} 
    link(rel="stylesheet", href="/css/style.css")
  body.bg-gray-100.min-h-screen.flex.flex-col
    .flex.flex-1.min-h-screen
      // Sidebar
      aside.w-64.bg-blue-800.text-white.flex-shrink-0.hidden.h-screen.sticky.top-0(class="md:flex flex-col")
        .p-6.border-b.border-blue-700
          h1.text-2xl.font-bold SILAB
          p.text-xs.text-blue-300 Sistem Inventaris Laboratorium
        
        nav.flex-1.p-4.space-y-1
          a.block.px-4.py-2.rounded.transition.font-semibold(
            href="/dashboard"
            class=(currentPath === '/dashboard' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
          ) Dashboard
          if user
            if user.role === 'ADMIN'
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/admin/users"
                class=(currentPath === '/admin/users' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Kelola Pengguna
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/admin/rooms"
                class=(currentPath === '/admin/rooms' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Kelola Ruangan
            if user.role === 'LAB_HEAD'
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/procurement"
                class=(currentPath === '/procurement' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Pengadaan Barang
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/procurement/inventory"
                class=(currentPath === '/procurement/inventory' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Daftar Inventaris &amp; BHP
            if user.role === 'LAB_STAFF'
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/staff/bhp"
                class=(currentPath === '/staff/bhp' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Kelola Stok BHP
              a.block.px-4.py-2.rounded.transition.font-semibold(
                href="/staff/maintenance"
                class=(currentPath === '/staff/maintenance' ? 'bg-blue-900 text-white' : 'text-blue-200 hover:bg-blue-700 hover:text-white')
              ) Log Maintenance &amp; Aset
        
        .p-4.border-t.border-blue-700
          form(action="/logout" method="POST")
            button(type="submit" class="w-full flex items-center gap-2 px-4 py-2 text-red-300 hover:bg-blue-900 rounded transition")
              span Keluar (Logout)

      // Main Content Area
      .flex-1.flex.flex-col
        header.bg-white.shadow-sm.p-4.flex.justify-between.items-center
          h2.text-xl.font-semibold.text-gray-800= title
          .text-sm.text-gray-600 Halo, #[span.font-bold= user.name]
        main.p-8
          block content

    //- Custom Confirmation Modal
    #confirm-modal(class="fixed inset-0 z-50 flex items-center justify-center hidden")
      // Back drop
      #confirm-backdrop(class="fixed inset-0 bg-gray-900 bg-opacity-50 transition-opacity duration-200 opacity-0")
      // Modal Content
      #confirm-content(class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 relative z-10 mx-4 transform transition-all scale-95 duration-200 opacity-0")
        .flex.items-start.gap-3.mb-4
          div(class="bg-red-50 text-red-600 rounded-full p-2.5 flex-shrink-0")
            svg.w-6.h-6(fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
          div
            h3#confirm-title.text-lg.font-bold.text-gray-900 Konfirmasi Tindakan
            p#confirm-message.text-sm.text-gray-500.mt-1 Apakah Anda yakin ingin melakukan tindakan ini?
        .flex.justify-end.gap-3
          button#confirm-cancel(type="button" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 text-sm font-semibold hover:bg-gray-50 transition") Batal
          button#confirm-ok(type="button" class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700 transition") Ya, Lanjutkan

    script.
      window.customConfirm = function(message, options = {}) {
        return new Promise((resolve) => {
          const modal = document.getElementById('confirm-modal');
          const backdrop = document.getElementById('confirm-backdrop');
          const content = document.getElementById('confirm-content');
          const titleEl = document.getElementById('confirm-title');
          const msgEl = document.getElementById('confirm-message');
          const cancelBtn = document.getElementById('confirm-cancel');
          const okBtn = document.getElementById('confirm-ok');

          titleEl.textContent = options.title || 'Konfirmasi';
          msgEl.textContent = message || 'Apakah Anda yakin?';
          okBtn.textContent = options.okText || 'Ya, Lanjutkan';

          if (options.variant === 'warning') {
            okBtn.className = 'px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold hover:bg-amber-600 transition';
          } else {
            okBtn.className = 'px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700 transition';
          }

          modal.classList.remove('hidden');
          // Trigger animations
          setTimeout(() => {
            backdrop.classList.remove('opacity-0');
            backdrop.classList.add('opacity-100');
            content.classList.remove('opacity-0', 'scale-95');
            content.classList.add('opacity-100', 'scale-100');
          }, 10);

          const cleanup = (value) => {
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0');
            content.classList.remove('opacity-100', 'scale-100');
            content.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
              modal.classList.add('hidden');
            }, 200);

            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            resolve(value);
          };

          function onOk() { cleanup(true); }
          function onCancel() { cleanup(false); }

          okBtn.addEventListener('click', onOk);
          cancelBtn.addEventListener('click', onCancel);
        });
      };


